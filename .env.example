# ====================
# 默认 LLM 配置
# ====================
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
LLM_DEFAULT_MODEL=qwen-flash

# ====================
# 多模型提供方（按需配置）
# ====================
DASHSCOPE_API_KEY=your_dashscope_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=your_deepseek_key
GLM_API_KEY=your_glm_key
GEMINI_API_KEY=your_gemini_key

# ====================
# 外部存储与中间件
# ====================
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=myagent
REDIS_URL=redis://127.0.0.1:6379
MILVUS_URL=http://127.0.0.1:19530
DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/dbname?charset=utf8mb4

ALIOSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIOSS_BUCKET_NAME=your_bucket
ALIOSS_ACCESS_KEY_ID=your_access_key_id
ALIOSS_ACCESS_KEY_SECRET=your_access_key_secret

# ====================
# 外部工具服务
# ====================
TAVILY_API_KEY=your_tavily_key
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
MINERU_API_KEY=your_mineru_key
GITHUB_TOKEN=your_github_token
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# ====================
# 循环决策预算
# ====================
MAX_CYCLES=12
MAX_BACKTRACKS=3
MAX_REPEAT_ACTIONS=2
MAX_STAGNANT_STEPS=3
